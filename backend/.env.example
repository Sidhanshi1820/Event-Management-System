# Event Management API - environment template
# Copy to .env and fill in real values.
# WARNING: .env holds real secrets and is gitignored. NEVER commit real
# secrets to version control - commit this example file instead.

MONGODB_URI=mongodb://localhost:27017/event_management
NODE_ENV=development
PORT=3000

# REQUIRED - the server refuses to boot if either is missing or empty.
# Values that still look like placeholders (your_..., change_this, ...)
# abort startup in production and warn in development.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://localhost:3000